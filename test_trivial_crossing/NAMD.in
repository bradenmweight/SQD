# Required Inputs
NSTATES = 3 ! Includes ground state. NSTATES = 1 for GS BOMD [int]
NSTEPS  = 1000 # Total MD steps [int]
dtI     = 0.1 # Nuclear time-step (fs) [float]
ESTEPS = 250 # Number of electronic time steps per nuclear step [int]
ISTATE  = 2 # Initial electronic state for NAMD: 0, 1, 2, ... [int]
FUNCTIONAL = AM1 # wB97XD # SVWN # DFT functional [str]
BASIS = STO-3G # Local basis set [str]
CHARGE = 0 # System's net charge [int]
MULTIPLICITY = 1 # System electronic multiplicity [int]
MEMORY = 4 # Memory for Gaussian (GB) [int]
NAMD_METHOD = spinLSC # EH, spinLSC - Controls which semi-classical/MQC method to use [str]
MD_ENSEMBLE = NVE

# Optional
VELOC = READ # {MB} {READ} -> read from "input_veloc.xyz", 
PARALLEL_FORCES = True # Uses 'NCPUS_NAMD' for distribution [Boolean] 
NCPUS_NAMD  = 2 # NCPUS , Dictates parallization across excited state forces. [int]
NCPUS_G16   = 12 # [int]
RUN_ELEC_STRUC = USE_CURRENT_NODE # USE_CURRENT_NODE, SUBMIT_SBATCH [str]
EL_PROP = DIAGONAL # RK (4th-order explicit Runge-Kutta), VV (Velocity-Verlet-like, second-order symplectic) [str]


